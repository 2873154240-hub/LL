# 复制为 backend/.env 后按需修改。所有项都有默认值，不配置也能跑。
# 已存在的系统环境变量优先于本文件（load_dotenv override=False）。

# ---- 基础 ----
# 默认已指向 backend/data/app.db（绝对路径，与启动目录无关），通常无需设置
# DATABASE_URL=sqlite:///C:/path/to/app.db
SECRET_KEY=change-me-in-production-please-0123456789abcdef
TOKEN_EXPIRE_MINUTES=10080

# ---- 站点所有者 ----
# 只有这个邮箱对应的账号能看到网页上的「站点开关」。
# 留空 = 关闭网页开关；命令行的 site_switch.py 仍然可用。
OWNER_EMAIL=

# ---- 计费 ----
ANALYSIS_COST=10
FREE_TOKENS_PER_DAY=50
# 充值定价按 USDT 自填金额：1 USDT = 100 Token，单笔 1–10000 USDT。
TOKENS_PER_USDT=100
MIN_RECHARGE_USDT=1
MAX_RECHARGE_USDT=10000

# ---- 邮件验证码 ----
# 留空 = 开发模式：验证码打印到控制台并随接口返回，不上锁
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
DEV_RETURN_CODE=1
CODE_TTL_SECONDS=300

# ---- LLM（OpenAI 兼容接口，留空则使用内置规则引擎）----
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=60

# ---- 行情 ----
# 只使用真实行情源：币圈走 Gate.io（Binance 作备用）。
# 数据源全部失败时接口返回 503，前端显示错误——不会退回合成数据。
MARKET_TIMEOUT=8

# ---- 支付：Binance Pay 商户收单 ----
# 默认关闭 = 模拟支付。开启前必须填好商户号、API Key、API Secret 三项，
# 否则 create_order 会报 502。只接商户 API，不接任何个人钱包地址。
BINANCE_PAY_ENABLED=0
BINANCE_PAY_MERCHANT_ID=
BINANCE_PAY_API_KEY=
BINANCE_PAY_API_SECRET=
BINANCE_PAY_BASE_URL=https://bpay.binanceapi.com
BINANCE_PAY_CURRENCY=USDT
BINANCE_PAY_TIMEOUT=15
# 可选：Binance 证书公钥文件（PEM）。留空则运行时调 /certificates 拉取并缓存。
BINANCE_PAY_CERT_FILE=
# 展示汇率：1 USDT = 多少 CNY（订单同时记录 USDT 与本币金额）。
USD_CNY_RATE=7.2
# 支付完成后的前端页面；webhook 必须是公网 HTTPS 地址（本地开发可留空，
# 在 Binance 商户后台配置，或用内网穿透工具转发）。
PAYMENT_RETURN_URL=http://localhost:5173/me
PAYMENT_CANCEL_URL=http://localhost:5173/me
PAYMENT_WEBHOOK_URL=

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
